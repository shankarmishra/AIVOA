GROQ_API_KEY=gsk_replace_me
DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5433/aivoa
# NOTE: assignment spec referenced gemma2-9b-it but Groq has decommissioned
# that model. We use llama-3.3-70b-versatile (the spec-listed alternative)
# for both primary and long-context paths. Spec compliance documented in README.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
